{
  "name": "@revisium/revo-tui",
  "version": "0.0.0",
  "private": true,
  "description": "Terminal client for Revo.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "revo-tui": "bin/revo-tui.js"
  },
  "exports": {
    "./launcher": {
      "types": "./dist/launcher/index.d.ts",
      "import": "./dist/launcher/index.js"
    }
  },
  "scripts": {
    "build": "pnpm build:launcher && pnpm build:ui",
    "build:launcher": "tsc -p tsconfig.launcher.json",
    "build:ui": "pnpm exec bun build src/app/main.tsx --target bun --packages external --outfile dist/ui/main.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "pnpm typecheck:launcher && pnpm typecheck:ui",
    "typecheck:launcher": "tsc -p tsconfig.launcher.json --noEmit",
    "typecheck:ui": "tsc -p tsconfig.ui.json --noEmit",
    "fsd:check": "steiger src",
    "verify:sources": "if [ -d src ]; then pnpm typecheck && pnpm fsd:check && pnpm build; else echo 'Source gates: N/A (src directory is not present)'; fi",
    "verify": "pnpm format:check && pnpm lint && pnpm verify:sources",
    "sonar:issues:local": "bash scripts/sonar-issues-local.sh"
  },
  "dependencies": {
    "@opentui/core": "0.5.11",
    "@opentui/react": "0.5.11",
    "bun": "1.4.2",
    "graphql": "16.14.2",
    "graphql-request": "6.1.0",
    "graphql-sse": "2.6.1",
    "mobx": "6.16.1",
    "mobx-react-lite": "4.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@feature-sliced/steiger-plugin": "0.5.8",
    "@eslint-react/eslint-plugin": "3.0.0",
    "@types/node": "26.1.2",
    "@types/react": "19.3.0",
    "eslint": "10.5.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-sonarjs": "4.1.0",
    "globals": "17.6.0",
    "prettier": "3.8.4",
    "steiger": "0.5.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.61.1"
  },
  "engines": {
    "node": ">=26.8.2 <27"
  },
  "packageManager": "pnpm@12.4.1"
}
